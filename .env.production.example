APP_NAME="DealFlow AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dealflow.example.com
APP_TIMEZONE=UTC

# AI negotiation
GOOGLE_API_KEY=
AI_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-3-flash-preview
DEALFLOW_AI_NEGOTIATION=true
DEALFLOW_AI_COST_PER_CALL_MINOR=1

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Production database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dealflow
DB_USERNAME=dealflow
DB_PASSWORD=change-me
DB_SSLMODE=require
DB_CHARSET=utf8

# Sessions, cache, queues
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@dealflow.example.com"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=warning

VITE_APP_NAME="DealFlow AI"
